# Copia para .env (ignorado pelo git). Nunca coloques segredos reais neste ficheiro.
DATABASE_URL=file:./data/tento.db

# Better Auth: gera um segredo longo e aleatório (por exemplo: openssl rand -base64 32)
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:5173

# Só para `pnpm db:seed` (desenvolvimento local): utilizador de demonstração com dados fictícios.
# A palavra-passe tem de ter pelo menos 12 caracteres.
DEMO_EMAIL=
DEMO_PASSWORD=
