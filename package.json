{
  "name": "tento",
  "version": "0.0.0",
  "private": true,
  "description": "Análise do fluxo de caixa das tuas contas nas casas de apostas: depósitos, levantamentos e resultado líquido.",
  "license": "UNLICENSED",
  "type": "module",
  "packageManager": "pnpm@10.28.2",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "concurrently -k -n web,api \"vite\" \"node --watch --import tsx src/server/entry/node.ts\"",
    "dev:web": "vite",
    "dev:api": "node --watch --import tsx src/server/entry/node.ts",
    "worker:dev": "pnpm build && wrangler d1 migrations apply DB --local && wrangler dev",
    "start": "tsx src/server/entry/node.ts --production",
    "build": "vite build",
    "build:sites": "node scripts/build-sites.mjs",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings=0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "e2e": "playwright test",
    "e2e:worker": "cross-env TENTO_E2E_TARGET=worker playwright test",
    "check": "pnpm lint && pnpm typecheck && pnpm format:check && pnpm test && pnpm build",
    "brand": "node scripts/brand.mjs",
    "prepare": "lefthook install",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx --env-file-if-exists=.env scripts/migrate.ts",
    "db:seed": "tsx --env-file-if-exists=.env scripts/seed.ts",
    "test:real": "vitest run src/core/csv/real-data.test.ts"
  },
  "dependencies": {
    "@fontsource-variable/fraunces": "^5.3.0",
    "@fontsource-variable/instrument-sans": "^5.3.0",
    "@fontsource/dm-mono": "^5.3.0",
    "@fontsource/fraunces": "^5.3.0",
    "@fontsource/instrument-sans": "^5.3.0",
    "@hono/node-server": "^2.1.3",
    "@hono/zod-validator": "^0.9.1",
    "@libsql/client": "^0.18.0",
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-select": "^2.3.7",
    "@radix-ui/react-toggle-group": "^1.1.19",
    "@react-pdf/renderer": "^4.9.0",
    "@tanstack/react-query": "^5.104.0",
    "@tanstack/react-router": "^1.170.41",
    "better-auth": "^1.7.7",
    "clsx": "^2.1.1",
    "d3-scale": "^4.0.2",
    "d3-shape": "^3.2.0",
    "drizzle-orm": "^0.45.3",
    "hono": "^4.13.12",
    "lucide-react": "^1.49.0",
    "papaparse": "^5.7.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@eslint/js": "9.39.5",
    "@playwright/test": "^1.63.0",
    "@resvg/resvg-js": "^2.6.2",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/router-plugin": "^1.168.42",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/d3-scale": "^4.0.9",
    "@types/d3-shape": "^3.2.0",
    "@types/node": "^24.19.0",
    "@types/papaparse": "^5.5.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitest/coverage-v8": "^5.0.3",
    "concurrently": "^10.0.5",
    "cross-env": "^10.1.0",
    "drizzle-kit": "^0.31.11",
    "eslint": "9.39.5",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react-hooks": "^7.1.1",
    "fast-check": "^4.10.2",
    "globals": "^17.12.0",
    "jsdom": "^30.1.1",
    "lefthook": "^2.1.15",
    "pdfjs-dist": "^6.3.289",
    "prettier": "^3.9.9",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "6.0.3",
    "typescript-eslint": "^8.71.0",
    "vite": "^8.3.1",
    "vitest": "^5.0.3",
    "wrangler": "^4.146.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "lefthook",
      "workerd"
    ],
    "overrides": {
      "@esbuild-kit/core-utils>esbuild": "^0.25.12"
    }
  }
}
